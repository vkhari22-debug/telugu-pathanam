{
  "name": "telugu-pathanam",
  "version": "1.0.0",
  "private": true,
  "description": "తెలుగు పఠనం - Telugu document reader with text-to-speech (PWA)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p . && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "icons": "node scripts/generate-icons.mjs",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "idb": "^8.0.4",
    "jszip": "^3.10.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^25.0.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^4.1.11"
  }
}
